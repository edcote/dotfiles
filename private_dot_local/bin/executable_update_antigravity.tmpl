#!/usr/bin/env python3
"""
update_antigravity - User-space on-demand updater for Google Antigravity suite (IDE, Hub, and agy CLI).
Maintains installations under ~/.local/opt and symlinks under ~/.local/bin without requiring root/sudo.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Dict, List, Optional

# Official Cloud Run Release Endpoints
IDE_RELEASES_API = "https://antigravity-ide-auto-updater-974169037036.us-central1.run.app/releases"
HUB_RELEASES_API = "https://antigravity-hub-auto-updater-974169037036.us-central1.run.app/releases"

# Standard User-Space Paths
HOME: Path = Path.home()
LOCAL_OPT: Path = HOME / ".local" / "opt"
LOCAL_BIN: Path = HOME / ".local" / "bin"
APPLICATIONS_DIR: Path = HOME / ".local" / "share" / "applications"

USER_AGENT = "Mozilla/5.0 (X11; Linux x86_64) Antigravity-Updater/2.0"


def print_info(msg: str) -> None:
    """Print standard informational message in blue."""
    print(f"\033[1;34m[INFO]\033[0m {msg}")


def print_success(msg: str) -> None:
    """Print success message in green."""
    print(f"\033[1;32m[SUCCESS]\033[0m {msg}")


def print_warn(msg: str) -> None:
    """Print warning message in yellow."""
    print(f"\033[1;33m[WARN]\033[0m {msg}")


def print_error(msg: str) -> None:
    """Print error message in red to stderr."""
    print(f"\033[1;31m[ERROR]\033[0m {msg}", file=sys.stderr)


def atomic_symlink(target_path: Path | str, symlink_path: Path) -> None:
    """Atomically create or replace a symlink using os.replace."""
    symlink_path.parent.mkdir(parents=True, exist_ok=True)
    temp_symlink = symlink_path.parent / f".tmp_{symlink_path.name}_{os.getpid()}"
    if temp_symlink.is_symlink() or temp_symlink.exists():
        temp_symlink.unlink()
    try:
        temp_symlink.symlink_to(target_path)
        os.replace(temp_symlink, symlink_path)
    finally:
        if temp_symlink.is_symlink() or temp_symlink.exists():
            temp_symlink.unlink()


def safe_tar_extract(tar: tarfile.TarFile, extract_path: Path) -> None:
    """Extract tarfile safely, supporting PEP 706 filters on Python 3.12+."""
    if hasattr(tarfile, "data_filter"):
        tar.extractall(extract_path, filter="data")
    else:
        tar.extractall(extract_path)


def fetch_json(url: str) -> Optional[List[Dict[str, Any]]]:
    """Fetch and parse JSON array from remote endpoint with robust error handling."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = resp.read()
            parsed = json.loads(data.decode("utf-8"))
            if isinstance(parsed, list):
                return parsed
            return None
    except urllib.error.HTTPError as e:
        print_error(f"HTTP error {e.code} ({e.reason}) fetching metadata from {url}")
        return None
    except urllib.error.URLError as e:
        print_error(f"Network error fetching metadata from {url}: {e.reason}")
        return None
    except Exception as e:
        print_error(f"Unexpected error fetching metadata from {url}: {e}")
        return None


def get_installed_ide_version() -> str:
    """Retrieve currently installed Antigravity IDE version string."""
    current_symlink = LOCAL_OPT / "antigravity-ide"
    if current_symlink.is_symlink() or current_symlink.exists():
        version_meta = current_symlink / "version.json"
        if version_meta.exists():
            try:
                with open(version_meta, "r", encoding="utf-8") as f:
                    meta: Dict[str, Any] = json.load(f)
                    return str(meta.get("version", "unknown"))
            except Exception:
                pass
        if current_symlink.is_symlink():
            target = os.readlink(str(current_symlink))
            if "-" in target:
                return target.split("-")[-1]
    return "none"


def get_installed_hub_version() -> str:
    """Retrieve currently installed Antigravity 2.0 Hub version string."""
    current_symlink = LOCAL_OPT / "antigravity-hub"
    if current_symlink.is_symlink() or current_symlink.exists():
        version_meta = current_symlink / "version.json"
        if version_meta.exists():
            try:
                with open(version_meta, "r", encoding="utf-8") as f:
                    meta: Dict[str, Any] = json.load(f)
                    return str(meta.get("version", "unknown"))
            except Exception:
                pass
        if current_symlink.is_symlink():
            target = os.readlink(str(current_symlink))
            if "-" in target:
                return target.split("-")[-1]
    return "none"


def get_installed_cli_version() -> str:
    """Retrieve currently installed agy CLI version string."""
    agy_bin = LOCAL_BIN / "agy"
    if agy_bin.exists() and os.access(agy_bin, os.X_OK):
        try:
            res = subprocess.run([str(agy_bin), "--version"], capture_output=True, text=True, timeout=5)
            if res.returncode == 0:
                lines = res.stdout.strip().splitlines()
                return lines[0] if lines else "installed"
        except Exception:
            pass
    return "none"


def update_desktop_entry() -> None:
    """Register or update .desktop entry for Linux desktop environments."""
    APPLICATIONS_DIR.mkdir(parents=True, exist_ok=True)
    desktop_file = APPLICATIONS_DIR / "antigravity.desktop"
    icon_path = LOCAL_OPT / "antigravity-ide" / "resources" / "app" / "resources" / "linux" / "code.png"

    content = f"""[Desktop Entry]
Name=Google Antigravity
Comment=AI-First Code Editor & Development Platform
GenericName=Text Editor
Exec={LOCAL_BIN / 'antigravity'} %F
Icon={icon_path if icon_path.exists() else 'antigravity'}
Type=Application
StartupNotify=true
StartupWMClass=Antigravity IDE
Categories=Development;IDE;TextEditor;
MimeType=text/plain;inode/directory;
Keywords=vscode;development;ide;ai;google;antigravity;
"""
    with open(desktop_file, "w", encoding="utf-8") as f:
        f.write(content)
    os.chmod(desktop_file, 0o755)
    print_info(f"Updated desktop entry at {desktop_file}")


def migrate_legacy_extensions_if_needed() -> None:
    """Ensure installed extensions and metadata are migrated to ~/.antigravity-ide."""
    legacy_ext = HOME / ".antigravity" / "extensions"
    new_ext = HOME / ".antigravity-ide" / "extensions"

    if legacy_ext.exists() and legacy_ext.is_dir():
        new_ext.mkdir(parents=True, exist_ok=True)
        legacy_items = list(legacy_ext.iterdir())
        if legacy_items:
            migrated_count = 0
            for item in legacy_items:
                dest = new_ext / item.name
                if not dest.exists():
                    if item.is_dir():
                        shutil.copytree(item, dest)
                    else:
                        shutil.copy2(item, dest)
                    migrated_count += 1

            # Migrate extensions.json metadata
            legacy_meta = legacy_ext / "extensions.json"
            new_meta = new_ext / "extensions.json"
            if legacy_meta.exists() and (not new_meta.exists() or new_meta.stat().st_size <= 2):
                try:
                    with open(legacy_meta, "r", encoding="utf-8") as f:
                        meta_text = f.read()
                    updated_meta = meta_text.replace("/.antigravity/extensions/", "/.antigravity-ide/extensions/")
                    with open(new_meta, "w", encoding="utf-8") as f:
                        f.write(updated_meta)
                except Exception as e:
                    print_warn(f"Failed to migrate extensions.json: {e}")
            if migrated_count > 0:
                print_info(f"Migrated {migrated_count} extension(s) from ~/.antigravity/extensions to ~/.antigravity-ide/extensions")


def download_and_extract(url: str, target_dir: Path, description: str) -> None:
    """Download tarball from CDN and extract into target directory."""
    print_info(f"Downloading {description} from {url}...")
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with tempfile.NamedTemporaryFile(suffix=".tar.gz", delete=False) as tmp_file:
        tmp_path = Path(tmp_file.name)
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                total_size = int(resp.headers.get("Content-Length", 0))
                downloaded = 0
                block_size = 1024 * 1024  # 1MB blocks
                while True:
                    chunk = resp.read(block_size)
                    if not chunk:
                        break
                    tmp_file.write(chunk)
                    downloaded += len(chunk)
                    if total_size > 0:
                        percent = (downloaded / total_size) * 100
                        mb = downloaded / (1024 * 1024)
                        total_mb = total_size / (1024 * 1024)
                        sys.stdout.write(f"\r  Progress: {mb:.1f}/{total_mb:.1f} MB ({percent:.1f}%)")
                        sys.stdout.flush()
            print()
            print_info(f"Extracting to {target_dir}...")
            target_dir.mkdir(parents=True, exist_ok=True)

            with tempfile.TemporaryDirectory() as extract_tmp:
                with tarfile.open(tmp_path, "r:gz") as tar:
                    safe_tar_extract(tar, Path(extract_tmp))

                extracted_items = list(Path(extract_tmp).iterdir())
                if len(extracted_items) == 1 and extracted_items[0].is_dir():
                    src_dir = extracted_items[0]
                else:
                    src_dir = Path(extract_tmp)

                if target_dir.exists():
                    shutil.rmtree(target_dir)
                shutil.copytree(src_dir, target_dir)

        finally:
            if tmp_path.exists():
                tmp_path.unlink()


def _ensure_ide_symlinks(install_target: Path) -> None:
    """Atomically set up opt symlink and write robust launcher wrapper in ~/.local/bin/antigravity."""
    symlink_opt = LOCAL_OPT / "antigravity-ide"
    atomic_symlink(install_target.name, symlink_opt)

    LOCAL_BIN.mkdir(parents=True, exist_ok=True)
    launcher_file = LOCAL_BIN / "antigravity"

    wrapper_content = """#!/usr/bin/env bash
set -euo pipefail

# Antigravity IDE Launcher Wrapper
# Handles Ubuntu 24.04+ AppArmor unprivileged user namespace restriction by passing --no-sandbox

readonly VSCODE_PATH="${HOME}/.local/opt/antigravity-ide"
readonly ELECTRON="${VSCODE_PATH}/antigravity-ide"
readonly CLI="${VSCODE_PATH}/resources/app/out/cli.js"

if [[ ! -x "${ELECTRON}" ]]; then
\techo "Error: Antigravity IDE executable not found at ${ELECTRON}" >&2
\techo "Run 'update_antigravity' to install or repair the installation." >&2
\texit 1
fi

ELECTRON_RUN_AS_NODE=1 exec "${ELECTRON}" "${CLI}" --no-sandbox "$@"
"""
    tmp_launcher = LOCAL_BIN / f".tmp_antigravity_{os.getpid()}"
    with open(tmp_launcher, "w", encoding="utf-8") as f:
        f.write(wrapper_content)
    os.chmod(tmp_launcher, 0o755)
    os.replace(tmp_launcher, launcher_file)
    print_success(f"Configured launcher wrapper at {launcher_file}")


def update_ide(force: bool = False, check_only: bool = False) -> bool:
    """Check, download, and update Antigravity IDE."""
    print_info("Checking Antigravity IDE releases...")
    releases = fetch_json(IDE_RELEASES_API)
    if not releases:
        print_error("Unable to retrieve IDE releases list.")
        return False

    latest = releases[0]
    latest_version: str = str(latest.get("version", ""))
    exec_id: str = str(latest.get("execution_id", ""))

    if not latest_version or not exec_id:
        print_error("Release metadata missing version or execution ID.")
        return False

    current_version = get_installed_ide_version()
    print_info(f"IDE: Current version = {current_version}, Latest version = {latest_version}")

    install_target = LOCAL_OPT / f"antigravity-ide-{latest_version}"

    if current_version == latest_version and not force and install_target.exists():
        print_success(f"Antigravity IDE is already up to date ({current_version}).")
        _ensure_ide_symlinks(install_target)
        migrate_legacy_extensions_if_needed()
        return True

    if check_only:
        print_warn(f"Update available for Antigravity IDE: {current_version} -> {latest_version}")
        return True

    download_url = f"https://edgedl.me.gvt1.com/edgedl/release2/j0qc3/antigravity/stable/{latest_version}-{exec_id}/linux-x64/Antigravity%20IDE.tar.gz"

    download_and_extract(download_url, install_target, f"Antigravity IDE {latest_version}")

    # Write version metadata
    with open(install_target / "version.json", "w", encoding="utf-8") as f:
        json.dump({"version": latest_version, "execution_id": exec_id}, f, indent=2)

    _ensure_ide_symlinks(install_target)
    migrate_legacy_extensions_if_needed()

    update_desktop_entry()
    print_success(f"Successfully installed Antigravity IDE {latest_version}!")
    return True


def update_cli(force: bool = False, check_only: bool = False) -> bool:
    """Check and update agy CLI."""
    print_info("Checking Antigravity CLI (agy)...")
    current_version = get_installed_cli_version()
    print_info(f"CLI: Current installed agy = {current_version}")

    agy_bin = LOCAL_BIN / "agy"
    if not agy_bin.exists():
        print_warn("agy binary not found in ~/.local/bin/agy.")
        return False

    if check_only:
        print_info("CLI check completed.")
        return True

    print_info("Executing 'agy update'...")
    try:
        res = subprocess.run([str(agy_bin), "update"], capture_output=True, text=True, timeout=60)
        if res.stdout.strip():
            print(res.stdout.strip())
        if res.stderr.strip():
            print(res.stderr.strip(), file=sys.stderr)
        if res.returncode == 0:
            new_version = get_installed_cli_version()
            print_success(f"agy status verified (now: {new_version})")
            return True
        else:
            print_error(f"'agy update' exited with code {res.returncode}")
            return False
    except Exception as e:
        print_error(f"Failed to run agy update: {e}")
        return False


def update_hub(force: bool = False, check_only: bool = False) -> bool:
    """Check, download, and update Antigravity 2.0 Desktop Hub."""
    print_info("Checking Antigravity 2.0 (Hub) releases...")
    releases = fetch_json(HUB_RELEASES_API)
    if not releases:
        print_error("Unable to retrieve Hub releases list.")
        return False

    latest = releases[0]
    latest_version: str = str(latest.get("version", ""))
    exec_id: str = str(latest.get("execution_id", "")).strip("/")

    if not latest_version or not exec_id:
        print_error("Hub release metadata missing version or execution ID.")
        return False

    current_version = get_installed_hub_version()
    print_info(f"Hub: Current version = {current_version}, Latest version = {latest_version}")

    install_target = LOCAL_OPT / f"antigravity-hub-{latest_version}"

    if current_version == latest_version and not force and install_target.exists():
        print_success(f"Antigravity 2.0 Hub is already up to date ({current_version}).")
        return True

    if check_only:
        print_warn(f"Update available for Antigravity 2.0 Hub: {current_version} -> {latest_version}")
        return True

    download_url = f"https://storage.googleapis.com/antigravity-public/antigravity-hub/{latest_version}-{exec_id}/linux-x64/Antigravity.tar.gz"

    download_and_extract(download_url, install_target, f"Antigravity 2.0 Hub {latest_version}")

    with open(install_target / "version.json", "w", encoding="utf-8") as f:
        json.dump({"version": latest_version, "execution_id": exec_id}, f, indent=2)

    symlink_opt = LOCAL_OPT / "antigravity-hub"
    atomic_symlink(install_target.name, symlink_opt)

    bin_symlink = LOCAL_BIN / "antigravity-hub"
    atomic_symlink(symlink_opt / "antigravity", bin_symlink)
    print_success(f"Linked {bin_symlink} -> {symlink_opt / 'antigravity'}")
    print_success(f"Successfully installed Antigravity 2.0 Hub {latest_version}!")
    return True


def main() -> None:
    """Main CLI entry point for update_antigravity."""
    parser = argparse.ArgumentParser(description="On-demand updater for Google Antigravity Suite (IDE, Hub, and CLI)")
    parser.add_argument("--check", action="store_true", help="Check for available updates without installing")
    parser.add_argument("--force", action="store_true", help="Force reinstallation even if versions match")
    parser.add_argument("--ide", action="store_true", help="Update only Antigravity IDE")
    parser.add_argument("--cli", action="store_true", help="Update only agy CLI")
    parser.add_argument("--hub", action="store_true", help="Install/Update Antigravity 2.0 Desktop Hub")
    parser.add_argument("--all", action="store_true", help="Update IDE, Hub, and CLI")

    args = parser.parse_args()

    LOCAL_OPT.mkdir(parents=True, exist_ok=True)
    LOCAL_BIN.mkdir(parents=True, exist_ok=True)

    print("==================================================")
    print("       Google Antigravity On-Demand Updater       ")
    print("==================================================")

    if args.check:
        print_info("Running in check/dry-run mode...")

    if args.ide:
        update_ide(force=args.force, check_only=args.check)
    elif args.cli:
        update_cli(force=args.force, check_only=args.check)
    elif args.hub:
        update_hub(force=args.force, check_only=args.check)
    elif args.all:
        update_ide(force=args.force, check_only=args.check)
        update_hub(force=args.force, check_only=args.check)
        update_cli(force=args.force, check_only=args.check)
    else:
        # Default behavior: Update IDE, Hub, and CLI
        update_ide(force=args.force, check_only=args.check)
        update_hub(force=args.force, check_only=args.check)
        update_cli(force=args.force, check_only=args.check)

    print("==================================================")
    print_success("Done!")


if __name__ == "__main__":
    main()

